# GTM Tracker — Backend Environment Variables
# Copy this file to .env and fill in values. Never commit .env to git.

PORT=3001

# Claude AI (Phase 3 chat) — get key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Google Sheets sync (Phase 5) — leave blank until Phase 5
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Email notifications — any SMTP provider (Gmail, SendGrid, etc.)
# Leave blank to disable (notifications will be logged to console only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
NOTIFY_FROM=GTM Tracker <you@gmail.com>

# App settings
DEFAULT_TIMEZONE=America/New_York
STALE_DAYS_THRESHOLD=14
